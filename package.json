{
  "name": "mcp-dolibarr-secure",
  "version": "3.0.0",
  "description": "Hardened fork of mcp-dolibarr: MCP server for Dolibarr ERP/CRM 23+/24 with read-only default, mandatory HTTP authentication, strict input validation and a route allowlist generated from the Dolibarr sources.",
  "private": true,
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-dolibarr": "build/index.js",
    "mcp-dolibarr-http": "build/http.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node build/index.js",
    "start:http": "node build/http.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=low"
  },
  "keywords": [
    "mcp",
    "dolibarr",
    "erp",
    "crm",
    "model-context-protocol"
  ],
  "author": "Digital Factory Senegal (upstream), hardened fork",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.20.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
