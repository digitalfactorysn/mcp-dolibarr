# ───────── Dolibarr (obligatoire) ─────────
# HTTPS obligatoire (http:// n'est accepté que pour localhost). Pas d'identifiants dans l'URL.
DOLIBARR_URL=https://erp.example.com
# Clé API d'un utilisateur Dolibarr DÉDIÉ, avec le minimum de droits (lecture seule si possible).
DOLIBARR_API_KEY=
# Version cible (facultatif) : 23.0.3 ou 24.0.1 → refuse les routes absentes de cette version.
DOLIBARR_VERSION=24.0.1

# ───────── Politique d'outils ─────────
# readonly (défaut) : seuls les outils de lecture sont exposés.
# readwrite        : outils de création/modification (hors « sensibles »).
MCP_MODE=readonly
# Avec readwrite : active en plus paiements, validations de factures, avoirs, suppressions, stock, salaires, dons…
MCP_ALLOW_SENSITIVE=false
# Listes d'outils (séparés par des virgules), facultatif.
# MCP_ENABLED_TOOLS=list_invoices,get_invoice
# MCP_DISABLED_TOOLS=get_setup_values
# Taille maximale de la réponse renvoyée au modèle (caractères).
# MCP_MAX_RESPONSE_CHARS=100000

# ───────── Transport HTTP (build/http.js) ─────────
# Jeton Bearer OBLIGATOIRE, 32 caractères minimum :  openssl rand -hex 32
MCP_API_TOKEN=
HOST=127.0.0.1
PORT=3100
# Origines navigateur autorisées (exactes). Vide = aucune (clients non-navigateur uniquement).
# MCP_ALLOWED_ORIGINS=https://claude.ai
# Noms d'hôte publics derrière un reverse proxy (protection DNS-rebinding).
# MCP_ALLOWED_HOSTS=mcp.example.com
# MCP_MAX_SESSIONS=20
# MCP_SESSION_TTL_MINUTES=30
# MCP_RATE_LIMIT_PER_MINUTE=120
# MCP_AUTH_FAILURES_PER_MINUTE=10
# Nombre de proxys de confiance devant le serveur (pour l'IP réelle des clients).
# MCP_TRUST_PROXY_HOPS=0
