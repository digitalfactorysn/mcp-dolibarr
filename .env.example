# ──────────────────────────────────────────────────────
# MCP Dolibarr — Configuration
# Digital Factory Senegal — https://digitalfactory.sn
# ──────────────────────────────────────────────────────
# Copiez ce fichier en .env et remplissez vos valeurs

# ── Dolibarr ──
# URL de base de l'API REST Dolibarr
# Exemple : https://erp.digitalfactory.sn/api/index.php
DOLIBARR_URL=https://votre-dolibarr.com/api/index.php

# Clé API Dolibarr (Utilisateurs > Profil > Clé API REST)
DOLIBARR_API_KEY=votre_cle_api_dolibarr

# ── Serveur HTTP (mode http uniquement) ──
# Port d'écoute du serveur HTTP
PORT=3000

# ── Sécurité (audit du 26/11/2026) ──
# Jeton Bearer OBLIGATOIRE en mode HTTP : sans lui le serveur refuse de démarrer.
# Générez-le avec : openssl rand -hex 32
MCP_API_TOKEN=

# Adresse d'écoute : 127.0.0.1 par défaut. Dans Docker, mettre 0.0.0.0 ET ne publier le port que sur
# 127.0.0.1 (voir docker-compose.yml), le proxy HTTPS joignant le conteneur par le réseau interne.
# HOST=127.0.0.1

# En-têtes Host acceptés sur /mcp (protection contre le DNS rebinding), ex. votre domaine public.
# MCP_ALLOWED_HOSTS=mcp.example.com
# Origines navigateur autorisées (CORS). Vide = aucune (les connecteurs Claude.ai n'en ont pas besoin).
# MCP_ALLOWED_ORIGINS=

# Sessions : durée d'inactivité (min), plafond, limite de requêtes par minute et par IP.
# MCP_SESSION_TTL_MIN=30
# MCP_MAX_SESSIONS=200
# MCP_RATE_LIMIT_PER_MIN=300

# Garde-fous des outils
# MCP_READ_ONLY=1                      → seulement les outils de lecture (get_, list_, search_…)
# MCP_DISABLED_TOOLS=delete_*,send_*   → outils retirés (noms ou préfixes avec *)
# MCP_MAX_LIMIT=100                    → plafond du paramètre « limit »

# Usage local isolé uniquement : autoriser le mode HTTP sans jeton (déconseillé).
# MCP_ALLOW_NO_AUTH=1
