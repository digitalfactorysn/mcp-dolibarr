# ──────────────────────────────────────────────────────
# MCP Dolibarr — Configuration
# Copiez ce fichier en .env et remplissez vos valeurs.
# Ne commitez jamais le fichier .env.
# ──────────────────────────────────────────────────────

# ── Dolibarr ──
# URL de votre instance (HTTPS obligatoire hors localhost)
DOLIBARR_URL=https://votre-dolibarr.example.com

# Clé API d'un utilisateur Dolibarr DÉDIÉ, avec les permissions minimales nécessaires
# (Utilisateurs & Groupes > [utilisateur] > Clé pour l'API)
DOLIBARR_API_KEY=votre_cle_api_dolibarr

# ── Restrictions des outils ──
# true = seuls les outils de consultation (list_*, get_*, export_*) sont exposés
DOLIBARR_READ_ONLY=true
# Liste d'outils à désactiver, séparés par des virgules (ex: delete_document,delete_invoice_line)
DOLIBARR_DISABLED_TOOLS=

# ── Serveur HTTP (mode distant uniquement, inutile en mode local stdio) ──
PORT=3000
# Interface d'écoute (127.0.0.1 par défaut ; 0.0.0.0 uniquement dans un conteneur)
HOST=127.0.0.1
# Jeton Bearer OBLIGATOIRE en mode HTTP (32 caractères min.) : openssl rand -hex 32
MCP_API_TOKEN=
# Origines navigateur autorisées (CORS), séparées par des virgules. Vide = aucune.
MCP_CORS_ORIGINS=
